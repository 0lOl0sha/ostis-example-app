cargo_train_subtype => nrel_inclusion: 
    long; 
    heavy; 
    dangerous;;

cargo_long_train -> long;;
cargo_long_heavy_train -> long; heavy;; 
cargo_long_heavy__dangerous_train -> long; heavy; dangerous;; 
cargo_heavy_train -> heavy;; 
cargo_heavy_dangerous_train -> heavy; dangerous;; 
cargo_dangerous_train -> dangerous;;